# ============================================
# 食探社 — 环境配置模板
# ============================================
# 使用方式：
#   1. 复制本文件为 .env
#      cp .env.example .env
#   2. 编辑 .env，替换为实际值
#   3. .env 已被 .gitignore 忽略，不会提交到仓库
# ============================================

# 数据库连接（MySQL）
# 格式：mysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql://root:your_password@localhost:3306/foodiehub

# JWT 签名密钥（生产环境请使用随机字符串）
JWT_SECRET_KEY=your-secret-key-change-in-production

# 调试模式（开发时设为 true，生产设为 false）
DEBUG=true
